<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="3"
            android:ellipsize="start"
            android:textColor="@color/calc_text"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/calc_sub"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_fn"
                android:stateListAnimator="@null"
                android:tag="clear"
                android:text="AC"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="24sp" />

            <Button
                android:id="@+id/key_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_fn"
                android:stateListAnimator="@null"
                android:tag="back"
                android:text="⌫"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="24sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_fn"
                android:stateListAnimator="@null"
                android:tag="%"
                android:text="%"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="24sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_op"
                android:stateListAnimator="@null"
                android:tag="÷"
                android:text="÷"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="7"
                android:text="7"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="8"
                android:text="8"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="9"
                android:text="9"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_op"
                android:stateListAnimator="@null"
                android:tag="×"
                android:text="×"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="4"
                android:text="4"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="5"
                android:text="5"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="6"
                android:text="6"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_op"
                android:stateListAnimator="@null"
                android:tag="−"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="1"
                android:text="1"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="2"
                android:text="2"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="3"
                android:text="3"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:id="@+id/key_plus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_op"
                android:stateListAnimator="@null"
                android:tag="+"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="2"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="0"
                android:text="0"
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_num"
                android:stateListAnimator="@null"
                android:tag="."
                android:text="."
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />

            <Button
                android:id="@+id/key_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/key_eq"
                android:stateListAnimator="@null"
                android:tag="="
                android:text="="
                android:textAllCaps="false"
                android:textColor="@color/calc_text"
                android:textSize="30sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
